--  Ada reference arithmetic (numeric contract) and the golden vector generator.
--  Build from the repo root:  gprbuild -P sw/ada/ref/qogpu_ref.gpr
--  Regenerate vectors:        make vectors
project Qogpu_Ref is
   for Source_Dirs use ("src");
   for Main use ("gen_vectors.adb");
   for Object_Dir use "../../../build/ada/ref/obj";
   for Exec_Dir use "../../../build/ada";
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  -gnata turns every precondition into a run-time check, so a vector
      --  outside the contract stops the generator instead of being written
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnata", "-gnato");
   end Compiler;
end Qogpu_Ref;
